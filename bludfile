AnimScape.html: mainhtml.xml *.js build.xslt
    xsltproc --xinclude build.xslt mainhtml.xml > AnimScape.html

preflight: AnimScape.html preflight.xsl
    xsltproc --html preflight.xsl AnimScape.html | node --check

index.html: AnimScape.html
    cp $< $@

publish: index.html
    shell git add index.html && (git diff --cached --quiet -- index.html || git commit -m "Publish AnimScape" -- index.html)
    shell git push

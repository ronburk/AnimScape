<?xml version="1.0" encoding="UTF-8"?>
<html xmlns:xi="http://www.w3.org/2001/XInclude">
    <head><meta charset="UTF-8"/><title>AnimScape</title><style>
        html, body { height: 100%; margin: 0; }
        body { display: flex; flex-direction: column; overflow: hidden; }
        #svg-viewer { width: 100%; flex: 1 1 auto; min-height: 0; overflow: auto; background: #f5f5f5; }
        #keyframe-panel { flex: 0 0 200px; height: 200px; min-height: 200px; max-height: 200px; overflow: hidden; padding: 8px 12px; box-sizing: border-box; background: white; border-top: 1px solid #ccc; font: 14px sans-serif; }
        #file-controls { flex: 0 0 20vh; min-height: 0; padding: 12px; box-sizing: border-box; }
        #error-dialog { max-width: min(32rem, calc(100vw - 2rem)); border: 2px solid #900; border-radius: 6px; padding: 1rem 1.25rem; }
        #error-dialog::backdrop { background: rgb(0 0 0 / 45%); }
        #error-dialog form { margin: 0; }
        #error-dialog h2 { margin: 0 0 0.75rem; color: #900; font-size: 1.25rem; }
        #error-dialog p { max-width: 28rem; white-space: pre-wrap; }
        #timeline-viewport, #gallery-viewport { overflow-x: auto; padding: 6px 4px; box-sizing: border-box; }
        #timeline-content, #keyframe-list { position: relative; min-width: 100%; }
        #timeline-content { height: 42px; }
        #keyframe-list { height: 96px; }
        .timeline-axis { position: absolute; top: 0; left: 0; height: 28px; border-bottom: 1px solid #999; pointer-events: none; }
        .timeline-tick { position: absolute; top: 0; height: 28px; border-left: 1px solid #aaa; color: #555; font-size: 11px; padding-left: 3px; box-sizing: border-box; }
        .timeline-marker { position: absolute; top: 18px; width: 10px; height: 10px; padding: 0; border: 0; background: #777; transform: translate(-50%, -50%) rotate(45deg); cursor: pointer; }
        .timeline-marker.selected { background: #d33; }
        .timeline-playhead, .gallery-playhead { position: absolute; top: 0; bottom: 0; width: 2px; background: #d33; pointer-events: none; z-index: 2; }
        .keyframe-thumbnail { position: absolute; top: 8px; width: 84px; height: fit-content; padding: 2px; border: 2px solid transparent; border-radius: 4px; background: white; color: #333; transform: translateX(-50%); }
        .keyframe-thumbnail.selected { border-color: #06c; }
        .keyframe-thumbnail.selected::before { content: ""; position: absolute; top: -12px; left: 50%; border: 6px solid transparent; border-top: 0; border-bottom-color: #06c; transform: translateX(-50%); }
        .keyframe-thumbnail svg { display: block; width: 60px; height: 38px; }
        .keyframe-thumbnail-label { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .keyframe-title-input { position: fixed; z-index: 1; box-sizing: border-box; font: 14px sans-serif; padding: 2px; }
        .keyframe-thumbnail-duration { display: block; color: #666; font-size: 12px; margin-top: 3px; }
        #keyframe-controls { display: flex; align-items: center; gap: 6px; flex-wrap: nowrap; white-space: nowrap; }
        #keyframe-controls label { margin-left: 8px; }
    </style></head>
    <body>
        <div id="svg-viewer"></div>
        <div id="file-controls">
            <button id="svg-file-button" type="button">Open</button>
            <label id="svg-file-selection" hidden="hidden">SVG file:
                <select id="svg-file-list"></select>
            </label>
            <button id="open-selected-svg-button" type="button" hidden="hidden">Open selected</button>
            <button id="export-png-button" type="button" disabled="disabled">Export PNG</button>
            <button id="export-webm-button" type="button" disabled="disabled">Render WebM</button>
        </div>
        <dialog id="error-dialog" aria-labelledby="error-dialog-title" aria-describedby="error-dialog-message">
            <form method="dialog">
                <h2 id="error-dialog-title">Operation failed</h2>
                <p id="error-dialog-message"></p>
                <button id="error-dialog-ok" type="submit">OK</button>
            </form>
        </dialog>
        <div id="keyframe-panel" hidden="hidden">
            <div id="timeline-viewport">
                <div id="timeline-content">
                    <div id="timeline-track"></div>
                    <div id="timeline-playhead" class="timeline-playhead"></div>
                </div>
            </div>
            <div id="gallery-viewport">
                <div id="keyframe-list" role="list">
                    <div id="gallery-playhead" class="gallery-playhead"></div>
                </div>
            </div>
            <div id="keyframe-controls">
                <button id="previous-keyframe-button" type="button">◀</button>
                <button id="play-button" type="button">Play</button>
                <button id="next-keyframe-button" type="button">▶</button>
                <label>Time to next: <input id="duration-input" type="number" min="0" step="0.1" value="1.0"/></label>
                <button id="delete-keyframe-button" type="button">Delete Keyframe</button>
            </div>
        </div>
        <script type="text/javascript"><xi:include href="fileio.js" parse="text"/></script>
        <script type="text/javascript"><xi:include href="svg.js" parse="text"/></script>
        <script type="text/javascript"><xi:include href="render.js" parse="text"/></script>
        <script type="text/javascript"><xi:include href="history.js" parse="text"/></script>
        <script type="text/javascript"><xi:include href="error.js" parse="text"/></script>
        <script type="text/javascript"><xi:include href="main.js" parse="text"/></script>
        <script type="text/javascript"><xi:include href="edit.js" parse="text"/></script>
    </body>
</html>
